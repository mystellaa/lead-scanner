# ---------------------------------------------------------------- 真实业务数据
# ⚠️ data/ 里是真实的客户线索（含手机号）、粘贴的截图、日志与备份。
#    属于个人隐私数据，绝对不要提交到仓库 —— 所以整个目录排除。
#    程序启动时会自动创建它，不影响别人 clone 下来直接运行。
data/

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------------------------------------------------------------- 虚拟环境
# 项目自带的运行环境约 300MB，依赖用 requirements-*.txt 还原即可
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------- 编辑器 / 系统
.vscode/
.idea/
*.swp
*.swo
*~

# Windows
Thumbs.db
Desktop.ini
ehthumbs.db

# macOS
.DS_Store
._*

# ---------------------------------------------------------------- 其它
*.log
*.bak
~$*
